# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (Azure Database for PostgreSQL recommended)
DATABASE_URL="postgresql://dam_user:password@localhost:5432/dam_db?schema=public"

# Redis (Azure Cache for Redis recommended)
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=

# Azure AD Authentication
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id
AZURE_AD_CLIENT_SECRET=your-client-secret
AZURE_AD_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback

# Azure Storage (for SharePoint)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# SharePoint (via Microsoft Graph API)
SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/DAM
SHAREPOINT_LIBRARY_NAME=Assets

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ArCo SPARQL Endpoint
ARCO_SPARQL_ENDPOINT=https://dati.beniculturali.it/sparql
ARCO_CACHE_TTL=604800

# MCP Server (separate microservice)
MCP_SERVER_URL=http://localhost:3001
MCP_SERVER_API_KEY=your-mcp-server-api-key-min-32-chars

# Elasticsearch (Azure can host or use Azure Cognitive Search)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# File Upload Limits
MAX_FILE_SIZE=104857600
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/tiff,application/pdf

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3001

# Azure Application Insights (recommended for production)
APPINSIGHTS_INSTRUMENTATIONKEY=
