# API Configuration
VITE_API_URL=http://localhost:3000

# Azure AD Configuration (optional - for direct frontend integration)
VITE_AZURE_AD_CLIENT_ID=your-azure-ad-client-id
VITE_AZURE_AD_TENANT_ID=your-azure-ad-tenant-id
VITE_AZURE_AD_REDIRECT_URI=http://localhost:3001/auth/callback

# Environment
VITE_NODE_ENV=development

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false
